{
  "type": "module",
  "name": "@nexso/eslint-config",
  "version": "3.0.3",
  "description": "Nexso Flat Config for modern JavaScript projects using ESLint 10",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint index.js index.test.js eslint.config.js",
    "prepublishOnly": "npm test && npm run lint",
    "test": "node ./index.test.js && node ./test-modern-features.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexsolab/eslint-config.git"
  },
  "keywords": [
    "eslintconfig",
    "eslint",
    "flat-config",
    "lint",
    "javascript",
    "code",
    "style",
    "development",
    "tool",
    "dev",
    "airbnb",
    "es6",
    "es2015",
    "es2016",
    "es2017",
    "es2018",
    "es2020",
    "es2021",
    "javascript"
  ],
  "author": "Gabriel Anderson <gcacars@gmail.com> (https://github.com/gcacars)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-security": "^4.0.1"
  },
  "devDependencies": {
    "eslint": "^10.7.0"
  },
  "peerDependencies": {
    "eslint": "^10.7.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
